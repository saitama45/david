# Copy this file to `.env.e2e` (which is gitignored) and fill in real values.
# The QA suite reads these to log in and to know where the app is running.

E2E_BASE_URL=http://127.0.0.1:8000

# Admin login (the /login page). Must be a real user that can access the entity below.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me

# Entity to select on the login form. Find the id in the `entities` table.
# Leave unset to auto-pick the first entity the login page offers.
E2E_ENTITY_ID=1

# Database backup, taken automatically before destructive runs (npm run qa:full /
# qa:demo). The path must be writable by the SQL Server service account (its
# default backup folder always is). Required for destructive runs.
E2E_DB_SERVER=localhost
E2E_DB_USER=sa
E2E_DB_PASSWORD=change-me
E2E_DB_NAME=daviddb
E2E_DB_BACKUP_PATH=C:\SQLBackups\daviddb_pre_e2e.bak
